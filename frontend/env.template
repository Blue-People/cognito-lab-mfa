# Configuración de AWS Cognito y API Gateway
# Copia este archivo como .env y reemplaza los valores después de desplegar el backend
# Obtén los valores ejecutando: cd backend && serverless info
#
# Para crear el archivo .env, ejecuta:
# cp env.template .env

# User Pool ID de Cognito (ejemplo: us-east-1_ABC123XYZ)
REACT_APP_USER_POOL_ID=

# Client ID del User Pool (ejemplo: 1a2b3c4d5e6f7g8h9i0j)
REACT_APP_CLIENT_ID=

# Endpoint del API Gateway HTTP API (ejemplo: https://abc123xyz.execute-api.us-east-1.amazonaws.com)
# No incluyas la barra final "/"
REACT_APP_API_ENDPOINT=

